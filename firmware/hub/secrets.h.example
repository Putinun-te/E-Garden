// Copy this file to secrets.h (same folder) and fill in your own values.
// secrets.h is listed in .gitignore. Never commit real credentials.
// All of these are only defaults: Wi-Fi and the web password can be changed
// later on the hub's setup page and are then stored in flash (NVS).
#ifndef SECRETS_H
#define SECRETS_H
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
// Password of the "EGarden-Setup" access point (at least 8 characters)
#define AP_PASSWORD "egarden-setup"
// Web UI login: user "admin" and this password (change it on the setup page)
#define WEB_PASSWORD "egarden"
// Only used when built with -DENABLE_CLOUD_UPLOAD (v1 LoRa_Master format)
#define SERVER_URL "https://YOUR_SERVER_HOST/api/Values/moontemp/"
#endif
